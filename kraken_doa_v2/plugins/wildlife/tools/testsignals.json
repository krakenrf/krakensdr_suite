  ["{tools}/collar_gen.py", "tx", "m4.cf32", "--rate", "48000", "--seconds", "30", "--json", "{\"type\": \"coded\", \"offset_hz\": 2600, \"gaps_ms\": [36.6, 24.4, 63.5], \"bi_s\": 10.0, \"start\": 2.3}"]
 ],
