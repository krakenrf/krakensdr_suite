{
 "id": "wildlife-na-collars",
 "title": "Wildlife collars, North America profile: four collars in the 150-152 MHz agency band",
 "description": "Four VHF collars around 151.000 MHz (a band North American agencies commonly use), 30 s looped, in a 50 kHz VFO, the decoder's profile set to North America: 150.985 MHz at 40 ppm (50 deg), 150.995 at 60 ppm (140 deg), 151.005 at 80 ppm with 15 ms pulses (220 deg) and a weak 151.015 at 24 ppm with 30 ms pulses (310 deg) - the rates of the USFS-documented collar (40 resting / 60 active / 80 mortality) and a slow one. No channel numbers (none exist there); every collar 'baseline' at its first rate (the profile's convention - a doubling over the resting rate = MORTALITY, toggling = activity - is checked offline: README, Tests). Expect four talkers at their bearings within ~15 s.",
 "rf_hz": 151000000.0,
 "tuner_offset_hz": 300000,
 "seconds": 30,
 "vfo": {"bw_khz": 50, "opts": {"profile": "na"}},
 "steps": [
  ["{tools}/collar_gen.py", "tx", "a.cf32", "--rate", "48000", "--seconds", "30", "--json", "{\"type\": \"train\", \"offset_hz\": -15000, \"ppm\": 40, \"width_ms\": 20, \"start\": 0.4, \"seed\": 11}"],
  ["{tools}/collar_gen.py", "tx", "b.cf32", "--rate", "48000", "--seconds", "30", "--json", "{\"type\": \"train\", \"offset_hz\": -5000, \"ppm\": 60, \"width_ms\": 22, \"start\": 0.75, \"seed\": 12}"],
