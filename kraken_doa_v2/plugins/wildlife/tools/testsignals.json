 "id": "wildlife-motus-tags",
 "title": "Wildlife tags, Motus profile: four Lotek-style coded tags on 166.380 MHz",
 "description": "Four Motus-style coded tags (4-pulse bursts, 2.5 ms pulses; the gaps = the Lotek ID, + the burst interval = the Motus tag) on the Americas' Motus frequency 166.380 MHz, 30 s looped, in a 50 kHz VFO, the decoder's profile set to Motus: two sharing one carrier (+150 Hz) - gaps 24.4 / 34.2 / 48.8 ms every 5.0 s (30 deg) and 41.5 / 26.9 / 58.6 ms every 6.0 s (110 deg) -, one at -1.8 kHz (29.3 / 51.3 / 22.0 ms, 7.5 s, 200 deg) and one at +2.6 kHz (36.6 / 24.4 / 63.5 ms, 10.0 s, 320 deg). The table names the channel 'Motus 166.380'. Expect four talkers (each after 3 bursts - the 10 s tag needs ~30 s) at their bearings.",
 "rf_hz": 166380000.0,
 "tuner_offset_hz": 300000,
 "seconds": 30,
 "vfo": {"bw_khz": 50, "opts": {"profile": "motus"}},
 "steps": [
  ["{tools}/collar_gen.py", "tx", "m1.cf32", "--rate", "48000", "--seconds", "30", "--json", "{\"type\": \"coded\", \"offset_hz\": 150, \"gaps_ms\": [24.4, 34.2, 48.8], \"bi_s\": 5.0, \"start\": 0.7}"],
  ["{tools}/collar_gen.py", "tx", "m2.cf32", "--rate", "48000", "--seconds", "30", "--json", "{\"type\": \"coded\", \"offset_hz\": 150, \"gaps_ms\": [41.5, 26.9, 58.6], \"bi_s\": 6.0, \"start\": 3.2}"],
