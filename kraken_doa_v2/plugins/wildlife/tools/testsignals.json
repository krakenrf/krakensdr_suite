  ["{tools}/collar_gen.py", "tx", "d.cf32", "--rate", "48000", "--seconds", "30", "--json", "{\"type\": \"train\", \"offset_hz\": 15000, \"ppm\": 24, \"width_ms\": 30, \"start\": 1.3, \"seed\": 14}"]
 ],
