# Build artifacts
obj/
dep/
kraken_doa

# Vendored dependency (auto-installed by Makefile)
uWebSockets/

# Runtime files
fingerprints.db
fftw_wisdom*
doa_settings.json
doa_settings.json.tmp
*.pem
*.key
*.crt

# DoA recordings (fixed output folder + common log extensions)
doa_recordings/
# 📼 IQ & audio recordings (the recorder's default folder; SigMF data /
# meta / .wav / .opus are ignored repo-wide in ../.gitignore)
recordings/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db
doa_log_*.csv

# Editor/backup files
*.backup
*.bak
*.swp
*~

# API access token (KRAKEN_API_TOKEN alternative) - a secret, never commit
api_token

# Decoder plugin builds (the sources in plugins/<id>/ are the plugin)
plugins/*/build/
plugins/sdk/build/
# AI Signal Lab: per-receiver config and session data (captures, analyses)
ai/ai_config.json
ai/ai_config.json.tmp
ai/sessions/
ai/**/__pycache__/

# incident map (incidents.cpp): incidents found in decoder messages, kept 24 h
incidents.tsv
incidents.tsv.tmp
# 📻 saved frequencies + map markers (saved_freqs.cpp) - positions near the station
saved_frequencies.json
saved_frequencies.json.tmp
saved_frequencies.json.bad
# the map markers before they became saved-frequency locations (migrated once)
map_markers.json
map_markers.json.tmp
map_markers.json.migrated
# ✈ the array calibration of THIS receiver (array_cal.cpp)
array_cal.json
array_cal.json.tmp
# decoder data log (sidebar 🗂 Decoder Logging), default folder
decoder_logs/
# mobile DF heat map session (rdf_mapper.cpp)
rdf_session.bin
rdf_session.bin.tmp
# this receiver's own noise floors per tuner and gain (noise_floor.cpp)
noise_floors.json
noise_floors.json.tmp
# Voice to Text (transcribe/setup.sh): the whisper.cpp checkout, the helper
# build and the downloaded speech models
transcribe/whisper.cpp/
transcribe/build/
transcribe/models/
# Voice to Text history + audio clips (voice2text.cpp)
transcripts.jsonl
transcripts.jsonl.tmp
voice_clips/
# Debug playback: generated test transmissions (plugins/sdk/tools/make_testsignal.py)
testsignal_cache/
# Python caches of the plugins' tools (generators run by make_testsignal.py)
plugins/**/__pycache__/
