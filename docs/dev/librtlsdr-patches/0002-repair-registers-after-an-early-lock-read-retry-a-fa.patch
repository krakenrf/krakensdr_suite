From 3adc8e615f0632db1bf8dd1a698e7763aa70cb75 Mon Sep 17 00:00:00 2001
From: Carl <admin@rtl-sdr.com>
Date: Sat, 21 Nov 2026 06:50:59 +1300
Subject: [PATCH] repair registers after an early lock read, retry a failed
 first read under NO_DUMMY_READ, exact NO_STREAM_SLIP wording

Review of e633601:
- a lock read that came before the PLL settled (a retry; or a finish that
  finds no lock) can leave 0x0b / 0x0c = 0xff and 0x1b / 0x1c corrupted
  while the cache holds the right values. r82xx_repair_early_read() waits
  R82XX_PLL_SETTLE_US, then writes 0x0b-0x0f and 0x1b-0x1f back from the
  cache (early_read_repairs counts it). Provoked with the settle at 0 on a
  KrakenSDR: 0 tunes left with a register off the cache in 2261 retried
  tunes (17 without); lag probe 0.000 samples per tune with the repairs.
- RTLSDR_TUNE_NO_DUMMY_READ: a failed first read (the access's control IN)
  makes the dummy read and tries once more (i2c_in_lazy_retries); the flag's
  header says the stall it guards was a Raspberry Pi finding, not
  reproduced here.
- RTLSDR_NO_STREAM_SLIP header: exactly which calls are covered and which
  reconfigure the stream; the rule is the data stage actually transferred.
- comments: the VCO-jump threshold is 400 MHz of VCO, measured only in the
  top divider (margin elsewhere, with the tunes it affects); set_pll_yc is
  unused (vco_algo is never 2); the padded IR read is harmless.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01VjXPtpwEy1fc9vNmq4LmHQ
---
 include/rtl-sdr.h     | 40 +++++++++++++---------
 include/tuner_r82xx.h |  1 +
 src/librtlsdr.c       | 28 ++++++++++++----
 src/tuner_r82xx.c     | 77 +++++++++++++++++++++++++++++++++++--------
 4 files changed, 111 insertions(+), 35 deletions(-)

diff --git a/include/rtl-sdr.h b/include/rtl-sdr.h
index 42d6c7d..10a8cb4 100755
--- a/include/rtl-sdr.h
+++ b/include/rtl-sdr.h
@@ -204,7 +204,11 @@ RTLSDR_API int rtlsdr_set_center_freq64(rtlsdr_dev_t *dev, uint64_t freq);
  *    tune's first I2C transfer is a write - a tune that starts with a tuner
  *    read (a same-band step with KEEP_AUTOTUNE: the register-4 read) has
  *    its control IN in front already: 1 USB transfer less (Windows makes no
- *    dummy read anyway).
+ *    dummy read anyway). Should that first read fail, the dummy read is
+ *    made and the read tried once more. The stall the dummy read guards
+ *    against was found on a Raspberry Pi 5; the flag was measured only on
+ *    an x86_64 PC, where no stall was ever seen with or without it - there
+ *    is no positive control for it yet.
  * (0x02 is not used.) flags 0 = rtlsdr_set_center_freq().
  *
  * \param dev the device handle given by rtlsdr_open()
@@ -231,20 +235,26 @@ RTLSDR_API int rtlsdr_set_center_freq_fast(rtlsdr_dev_t *dev, uint32_t freq, int
 RTLSDR_API int rtlsdr_finish_tune(rtlsdr_dev_t *dev);
 
 /*
- * Defined when no USB control transfer of this library drops samples from a
- * running stream (rtlsdr_read_async / rtlsdr_read_sync): a retune
- * (rtlsdr_set_center_freq, _fast, rtlsdr_finish_tune), a gain or IF mode
- * change, a GPIO / bias tee write or a register read leaves the stream's
- * sample count intact, so dongles streaming together stay in step whatever
- * each is told. Measured on a KrakenSDR (five R820T): the RTL2832U drops 4
- * bytes (2 I/Q samples) of its bulk stream for every USB control IN whose
- * data stage is 3, 7, 11 ... bytes long - the R820T's PLL lock check (a
- * read of 3 tuner registers on every tune) shifted a retuned dongle's
- * stream by 2 samples a tune against the others. This library makes no IN
- * of such a length (librtlsdr.c, rtlsdr_ctrl_transfer_retry). What moves a
- * stream on purpose: rtlsdr_set_sample_freq_correction* (the sample clock);
- * not measured: the calls that reset the demodulator (sample rate, direct
- * sampling, test / AGC modes) and rtlsdr_reset_buffer while streaming.
+ * Defined when no tune drops samples from a running stream
+ * (rtlsdr_read_async / rtlsdr_read_sync), so dongles streaming together stay
+ * in step however differently each one is retuned. Exactly what holds:
+ * rtlsdr_set_center_freq, rtlsdr_set_center_freq_fast, rtlsdr_finish_tune,
+ * the gain, gain mode, IF mode and AGC calls, the GPIO / bias tee calls,
+ * rtlsdr_is_tuner_PLL_locked, rtlsdr_get_tuner_i2c_register and every other
+ * control transfer this library makes itself leave the stream's sample
+ * count intact. Outside the promise: rtlsdr_reset_buffer,
+ * rtlsdr_set_sample_rate (a demodulator soft reset), direct-sampling and
+ * offset-tuning changes reconfigure the stream; the sample-clock calls
+ * (rtlsdr_set_sample_freq_correction*) move it on purpose.
+ * The rule, measured on a KrakenSDR (five R820T): the RTL2832U drops 4 bytes
+ * (2 I/Q samples) of its bulk stream for every USB control IN whose data
+ * stage - the bytes the device actually sends back - is 3, 7, 11 ... bytes
+ * long. The R820T's PLL lock check read 3 tuner registers on every tune.
+ * The library's own control INs are made one byte longer where needed
+ * (librtlsdr.c, rtlsdr_ctrl_transfer_retry): its register reads return
+ * exactly what is asked. libusb's string-descriptor reads (the
+ * rtlsdr_get_*usb_strings calls) ask for 255 bytes and get the descriptor's
+ * even length (measured: no drop).
  */
 #define RTLSDR_NO_STREAM_SLIP 1
 
diff --git a/include/tuner_r82xx.h b/include/tuner_r82xx.h
index 7d19e93..0c8737a 100755
--- a/include/tuner_r82xx.h
+++ b/include/tuner_r82xx.h
@@ -87,6 +87,7 @@ struct r82xx_priv {
 	int							mux_range;		/* freq_ranges[] index of the last r82xx_set_mux, -1 = none */
 	uint8_t						pll_settle;		/* next lock read waits R82XX_PLL_SETTLE_US (divider / band changed, a big VCO jump) */
 	uint32_t					last_vco_khz;	/* VCO of the last tune (0 = none): R82XX_PLL_SETTLE_VCO_JUMP_KHZ */
+	unsigned int				early_read_repairs;	/* r82xx_repair_early_read() calls (a count for tests) */
 	uint8_t						tune_flags;		/* R82XX_TUNE_* of the rtlsdr_set_center_freq_fast() call running */
 	uint8_t						tune_pending;	/* PLL autotune clock (maybe) still at 128 kHz: r82xx_finish_tune() */
 	uint8_t						buf[NUM_REGS + 1];
diff --git a/src/librtlsdr.c b/src/librtlsdr.c
index 0b955aa..4c02c13 100644
--- a/src/librtlsdr.c
+++ b/src/librtlsdr.c
@@ -101,11 +101,17 @@ typedef int socklen_t;
  * 63 - any vendor block (USB, SYS, demod, I2C to the tuner or the EEPROM)
  * and the standard GET_DESCRIPTOR alike, also at 1.2 MS/s (a byte count, not
  * time); 0.000 for 1, 2, 4, 5, 6, 8, 9, 10, 12, 13, 14, 16, 64, for every
- * write, and for a read that failed (no data stage). Such a read is made one
- * byte longer into a bounce buffer and the caller gets its own bytes: the
- * one more register (or tuner / EEPROM byte) read has no effect - none of
- * the library's reads is of a register that changes when read. (The R820T
- * PLL lock check read 3 tuner registers on every tune: 2 samples a tune.) */
+ * write, and for a read that failed (no data stage). What counts is the
+ * data stage actually transferred: the RTL2832U's vendor reads return
+ * exactly wLength bytes, so such a read is made one byte longer (wLength
+ * % 4 == 0) into a bounce buffer and the caller gets its own bytes. The one
+ * more byte read has no effect: R820T registers 0..4 are read-only status,
+ * the demod / USB / SYS registers the library reads don't change when read,
+ * EEPROM reads are 1 byte, and rtlsdr_ir_query's IR_RX_BUF is code RAM
+ * (0xFC00..) that the query clears right after the read. Standard requests
+ * made by libusb itself (string descriptors, wLength 255) return the
+ * descriptor's own, even, length. (The R820T PLL lock check read 3 tuner
+ * registers on every tune: 2 samples a tune.) */
 #define RTLSDR_CTRL_IN_PAD_MAX	255
 static int rtlsdr_ctrl_transfer_retry(libusb_device_handle *devh, uint8_t request_type,
 	uint8_t request, uint16_t value, uint16_t index, unsigned char *data, uint16_t length,
@@ -463,6 +469,7 @@ struct rtlsdr_dev {
 	 * none is made if a tuner read comes first */
 	int i2c_in_lazy;
 	int i2c_in_due;
+	unsigned int i2c_in_lazy_retries;	/* first reads that failed under it and were retried (a count for tests) */
 	int rc_active;
 	int verbose;
 	int dev_num;
@@ -1070,13 +1077,22 @@ int rtlsdr_i2c_write(rtlsdr_dev_t *dev, uint8_t i2c_addr, uint8_t *buffer, int l
 int rtlsdr_i2c_read(rtlsdr_dev_t *dev, uint8_t i2c_addr, uint8_t *buffer, int len)
 {
 	uint16_t addr = i2c_addr;
-	int r;
+	int r, due;
 
 	if (!dev)
 		return -1;
 
+	due = dev->i2c_in_due;
 	dev->i2c_in_due = 0;	/* this read is the control IN in front */
 	r = rtlsdr_read_array(dev, IICB, addr, buffer, len);
+	if (r < 0 && due) {
+		/* RTLSDR_TUNE_NO_DUMMY_READ: the access's first transfer failed -
+		 * make the dummy read it left out and try once more (an IN is
+		 * never retried in rtlsdr_ctrl_transfer_retry) */
+		dev->i2c_in_lazy_retries++;
+		rtlsdr_demod_read_reg(dev, 0x0a, 0x01, 1);
+		r = rtlsdr_read_array(dev, IICB, addr, buffer, len);
+	}
 	if (r < 0)
 		dev->i2c_repeater_on = 0;	/* as in rtlsdr_i2c_write */
 	return r;
diff --git a/src/tuner_r82xx.c b/src/tuner_r82xx.c
index 2cda5df..97cff07 100644
--- a/src/tuner_r82xx.c
+++ b/src/tuner_r82xx.c
@@ -65,16 +65,23 @@
  * (same divider, same band) don't wait. */
 #define R82XX_PLL_SETTLE_US	5000
 
-/* ... and after a tune that moved the VCO by more than this within one
- * divider and band. Measured on the KrakenSDR (2026-11-21, random
- * frequencies 24-1766 MHz, 5 dongles): without it 3.3-3.5 % of all tunes
- * read the lock before the PLL had settled (a lock retry; 1-4 left 0x0b =
- * 0xff, some 0x1b / 0x1c corrupted - the stream ~30 dB weaker), every one
- * a jump of more than 400 MHz (VCO > 800 MHz) in the top divider (RF
- * 885-1766 MHz, all one band, so no settle); 0 retries in 4597 same-divider
- * jumps of less than 400 MHz (any divider; 790 of 300-400 MHz in the top
- * one, VCO 600-800 MHz). 400 MHz of VCO = half of that: a
- * sweep's hops (2.4 MHz RF, at most 154 MHz VCO at 24 MHz) never wait. */
+/* ... and after a tune that moved the VCO by more than this (400 MHz of
+ * VCO) within one divider and band. Measured on the KrakenSDR (2026-11-21,
+ * random frequencies 24-1766 MHz, 5 dongles): without it 3.3-3.5 % of all
+ * tunes read the lock before the PLL had settled (a lock retry; 1-4 left
+ * 0x0b = 0xff, some 0x1b / 0x1c corrupted - the stream ~30 dB weaker),
+ * every one a jump of more than 400 MHz of RF (= 800 MHz of VCO) in the
+ * top divider (mix_div 2, RF 885-1766 MHz, all one band, so no settle); 0
+ * retries in 4597 same-divider jumps of less than 400 MHz of RF (790 of
+ * 300-400 MHz in the top divider, VCO 600-800 MHz). The threshold, 400 MHz
+ * of VCO, is half the smallest VCO jump seen to need it. Measured only in
+ * the top divider; in the others it is margin - there it makes these tunes
+ * wait (same divider and band, LO jump > 400 MHz / mix_div): mix_div 64
+ * (LO 27.7-55 MHz) > 6.25 MHz within LO 27.7-50, 32 none (its bands are <=
+ * 10 MHz wide), 16 > 25 MHz inside 140-180 / 180-220, 8 > 50 MHz inside
+ * 310-442, 4 > 100 MHz inside 450-588 / 650-885, 2 > 200 MHz. A sweep's
+ * hops (2.4 MHz, at most 154 MHz of VCO at 24 MHz) and drag steps never
+ * wait. */
 #define R82XX_PLL_SETTLE_VCO_JUMP_KHZ	400000
 
 /* The PLL lock check (r82xx_set_pll, r82xx_set_pll_yc, r82xx_finish_tune)
@@ -89,7 +96,8 @@
  * 3 - and 0x1b / 0x1c corrupted (any length, 3 too: the stream ~30 dB
  * weaker until they are rewritten); with the 5000 us wait no lock read came
  * early in 2026-11-21's KrakenSDR runs (docs/dev/librtlsdr-fork.md of the
- * KrakenSDR suite). */
+ * KrakenSDR suite), and should one still, r82xx_repair_early_read() puts
+ * those registers back. */
 #define R82XX_LOCK_READ_LEN	4
 
 #ifdef _WIN32
@@ -901,7 +909,39 @@ static int r82xx_set_mux(struct r82xx_priv *priv, uint64_t freq)
 }
 
 
-/* function of Youssef (AirSpy) and Carl (RTL-SDR) */
+/* A lock read that came before the PLL settled (a lock retry; provoked with
+ * the settle wait shortened - docs/dev/librtlsdr-fork.md of the KrakenSDR
+ * suite) can leave tuner registers corrupted while the cache holds the
+ * right values, so nothing would ever rewrite them: 0x0b / 0x0c = 0xff (IF
+ * VGA at maximum, +13 dB), 0x1b / 0x1c (~-30 dB), and - for I2C writes made
+ * straight after such a read - 0x0d-0x0f and 0x19. So after a retry, and
+ * when the finish finds no lock, this waits R82XX_PLL_SETTLE_US, so that its
+ * own writes don't meet an unsettled PLL, then writes 0x0b-0x0f and
+ * 0x1b-0x1f back from the cache (2 I2C writes; registers never seen hit go
+ * out with their same values). Measured with the settle wait at 0 (2261
+ * retried tunes in 5 min): 0 tunes left with a register off the cache (17
+ * without the repair). Not covered: early reads that already saw the lock
+ * (no retry) - they hit 0x1b / 0x1c 5 times in the same run; repairing
+ * after every settle-point tune instead removed those but left 6 dongles
+ * with the PLL unlocked at rest and cost ~12 ms per settle point, so it
+ * isn't done. With the 5000 us settle neither case was ever seen.
+ * (0x17-0x1a are not rewritten: a build that did had more level drops, put
+ * right only by rewriting PLL registers.) */
+static void r82xx_repair_early_read(struct r82xx_priv *priv)
+{
+	uint8_t v[5];
+
+	r82xx_settle_wait(R82XX_PLL_SETTLE_US);
+	memcpy(v, &priv->regs[0x0b - REG_SHADOW_START], 5);
+	r82xx_write_arr(priv, 0x0b, v, 5);
+	memcpy(v, &priv->regs[0x1b - REG_SHADOW_START], 5);
+	r82xx_write_arr(priv, 0x1b, v, 5);
+	priv->early_read_repairs++;
+}
+
+/* function of Youssef (AirSpy) and Carl (RTL-SDR) - vco_algo 2 only, which
+ * nothing sets (the vcoalgo= option writes vco_curr_max): not in use, no
+ * settle wait */
 static int r82xx_set_pll_yc(struct r82xx_priv *priv, uint32_t freq)
 {
   const uint32_t vco_min = 1770000000;
@@ -1051,7 +1091,7 @@ static int r82xx_set_pll_yc(struct r82xx_priv *priv, uint32_t freq)
 static int r82xx_set_pll(struct r82xx_priv *priv, uint32_t freq)
 {
 	/* freq == tuner's LO frequency */
-	int rc, i;
+	int rc, i, early = 0;
 	uint64_t vco_freq;
 	uint64_t vco_div;
 	uint32_t vco_min = 1770000; /* kHz */
@@ -1299,7 +1339,9 @@ static int r82xx_set_pll(struct r82xx_priv *priv, uint32_t freq)
 			break;
 
 		if (!i) {
-			/* Didn't lock. Increase VCO current */
+			/* Didn't lock: this read came early */
+			early = 1;
+			/* Increase VCO current */
 			if (priv->last_vco_curr != vco_curr_max) {
 				rc = r82xx_write_reg_mask(priv, 0x12, vco_curr_max, 0xe0);
 				if (rc < 0) {
@@ -1312,6 +1354,11 @@ static int r82xx_set_pll(struct r82xx_priv *priv, uint32_t freq)
 		}
 	}
 
+	/* a lock read came before the PLL had settled (a retry): put back the
+	 * registers such a read can corrupt (r82xx_repair_early_read) */
+	if (early)
+		r82xx_repair_early_read(priv);
+
 	if (!(data[2] & 0x40)) {
 		if (priv->cfg->verbose || PRINT_PLL_ERRORS)
 			fprintf(stderr, "[R82XX] PLL not locked at Tuner LO %u Hz for RF %f MHz!\n",
@@ -1361,6 +1408,8 @@ int r82xx_finish_tune(struct r82xx_priv *priv)
 	if (rc < 0)
 		return rc;
 	if (!(data[2] & 0x40)) {
+		/* not locked: this read may have met an unsettled PLL too */
+		r82xx_repair_early_read(priv);
 		if (priv->cfg->verbose || PRINT_PLL_ERRORS)
 			fprintf(stderr, "[R82XX] PLL not locked at the end of a drag (RF %f MHz)!\n",
 				priv->rf_freq * 1E-6);
