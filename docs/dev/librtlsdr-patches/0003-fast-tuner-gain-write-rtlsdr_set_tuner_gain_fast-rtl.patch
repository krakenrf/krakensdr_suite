From ba70ffe3a5f82cc1da926e75b760fd78169a9b0f Mon Sep 17 00:00:00 2001
From: Carl <admin@rtl-sdr.com>
Date: Mon, 23 Nov 2026 11:20:49 +1300
Subject: [PATCH] fast tuner gain write: rtlsdr_set_tuner_gain_fast,
 rtlsdr_set_center_freq_gain_fast

For a gain written with nearly every retune (a sweep's per-hop gain):
- r82xx_set_gain_fast(): the manual gain r82xx_set_gain(priv, 1, gain)
  sets - the same table and rounding, cache and last_* values, the IF VGA
  left as it is - without that call's unused read of registers 0..3, and
  with LNA (0x05) and mixer (0x07) in one I2C write of 0x05..0x07 when both
  change; nothing written when unchanged. AGC / extended mode: the
  ordinary path.
- rtlsdr_set_tuner_gain_fast(dev, gain, flags): that write alone.
- rtlsdr_set_center_freq_gain_fast(dev, freq, gain, flags): the fast tune,
  then the gain in the same I2C repeater hold - no dummy read in front.
- Other tuners / direct sampling: the ordinary calls. RTLSDR_HAS_GAIN_FAST.

KrakenSDR, 5 dongles streaming, 5 in parallel: gain 9.1 ms / 4 transfers ->
4.8 / 2; tune + gain 16.6 / 7.4 -> 9.9 / 4.4 (tune alone 7.4 / 3.4);
registers and level identical to the ordinary call over the whole table.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01VjXPtpwEy1fc9vNmq4LmHQ
---
 include/rtl-sdr.h     | 39 +++++++++++++++++++++++
 include/tuner_r82xx.h |  1 +
 src/librtlsdr.c       | 72 +++++++++++++++++++++++++++++++++++++++++++
 src/tuner_r82xx.c     | 42 +++++++++++++++++++++++++
 4 files changed, 154 insertions(+)

diff --git a/include/rtl-sdr.h b/include/rtl-sdr.h
index 10a8cb4..69ee037 100755
--- a/include/rtl-sdr.h
+++ b/include/rtl-sdr.h
@@ -234,6 +234,45 @@ RTLSDR_API int rtlsdr_set_center_freq_fast(rtlsdr_dev_t *dev, uint32_t freq, int
  */
 RTLSDR_API int rtlsdr_finish_tune(rtlsdr_dev_t *dev);
 
+/*!
+ * A manual tuner gain in fewer USB transfers, for a gain written with nearly
+ * every retune (a sweep's per-hop gain). The same gain as
+ * rtlsdr_set_tuner_gain(dev, gain) - the same table and rounding, the same
+ * register cache, so any later call behaves as after the ordinary one - but
+ * without its unused read of tuner registers 0..3, and with the LNA and the
+ * mixer gain in one I2C write when both change; nothing is written when the
+ * tuner already has that gain. The IF VGA (rtlsdr_set_tuner_if_mode) is left
+ * as it is, as rtlsdr_set_tuner_gain() leaves it. Not in manual gain mode
+ * (tuner AGC), and with any tuner other than the R820T / R828D or in direct
+ * sampling: rtlsdr_set_tuner_gain() itself.
+ * flags: RTLSDR_TUNE_NO_DUMMY_READ as for rtlsdr_set_center_freq_fast() (a
+ * write comes first here, so the dummy read is still made: the flag changes
+ * nothing for this call alone). Reads no 3 mod 4 bytes: drops no samples.
+ *
+ * \param dev the device handle given by rtlsdr_open()
+ * \param gain in tenths of a dB, as rtlsdr_set_tuner_gain()
+ * \param flags RTLSDR_TUNE_NO_DUMMY_READ or 0
+ * \return 0 on success, < 0 on an I/O error (the registers not written are
+ *         marked so that the next gain call writes them)
+ */
+RTLSDR_API int rtlsdr_set_tuner_gain_fast(rtlsdr_dev_t *dev, int gain, int flags);
+
+/*!
+ * rtlsdr_set_center_freq_fast(dev, freq, flags), then the gain as
+ * rtlsdr_set_tuner_gain_fast(dev, gain) in the same hold of the I2C
+ * repeater: the tune's own transfers come first, so no dummy read is needed
+ * before the gain write - 1 USB transfer more than the tune when the gain
+ * changes (LNA and mixer in one write), none when it doesn't. The gain is
+ * written even when the tune fails. Other tuners / direct sampling: the
+ * fast tune, then rtlsdr_set_tuner_gain().
+ *
+ * \return the tune's result if it failed (< 0), else the gain's
+ */
+RTLSDR_API int rtlsdr_set_center_freq_gain_fast(rtlsdr_dev_t *dev, uint32_t freq, int gain, int flags);
+
+/* rtlsdr_set_tuner_gain_fast() and rtlsdr_set_center_freq_gain_fast() exist */
+#define RTLSDR_HAS_GAIN_FAST 1
+
 /*
  * Defined when no tune drops samples from a running stream
  * (rtlsdr_read_async / rtlsdr_read_sync), so dongles streaming together stay
diff --git a/include/tuner_r82xx.h b/include/tuner_r82xx.h
index 0c8737a..654e709 100755
--- a/include/tuner_r82xx.h
+++ b/include/tuner_r82xx.h
@@ -167,6 +167,7 @@ int r82xx_is_tuner_locked(struct r82xx_priv *priv);
 #define R82XX_TUNE_SPAN_AUTOTUNE	0x04
 int r82xx_finish_tune(struct r82xx_priv *priv);
 int r82xx_set_gain(struct r82xx_priv *priv, int set_manual_gain, int gain, int extended_mode, int lna_gain, int mixer_gain, int vga_gain, int *rtl_vga_control);
+int r82xx_set_gain_fast(struct r82xx_priv *priv, int gain, int *rtl_vga_control);
 int r82xx_get_rf_gain(struct r82xx_priv *priv);
 int r82xx_get_if_gain(struct r82xx_priv *priv);
 
diff --git a/src/librtlsdr.c b/src/librtlsdr.c
index 4c02c13..787984b 100644
--- a/src/librtlsdr.c
+++ b/src/librtlsdr.c
@@ -1874,6 +1874,78 @@ int rtlsdr_finish_tune(rtlsdr_dev_t *dev)
 	return r;
 }
 
+/* the R820T / R828D fast gain write, cs_mutex held and the repeater on */
+static int rtlsdr_r82xx_gain_fast(rtlsdr_dev_t *dev, int gain)
+{
+	int rtl_vga_control = 0;
+	int rc = r82xx_set_gain_fast(&dev->r82xx_p, gain, &rtl_vga_control);
+
+	return rtlsdr_vga_control(dev, rc, rtl_vga_control);
+}
+
+int rtlsdr_set_tuner_gain_fast(rtlsdr_dev_t *dev, int gain, int flags)
+{
+	int r;
+
+	#ifdef _ENABLE_RPC
+	if (rtlsdr_rpc_is_enabled())
+	{
+	  return rtlsdr_rpc_set_tuner_gain(dev, gain);
+	}
+	#endif
+	if (!dev || !dev->tuner)
+		return -1;
+	if (!rtlsdr_fast_tune_applies(dev))
+		return rtlsdr_set_tuner_gain(dev, gain);
+
+	pthread_mutex_lock(&dev->cs_mutex);
+	dev->i2c_in_lazy = (flags & RTLSDR_TUNE_NO_DUMMY_READ) != 0;
+	rtlsdr_set_i2c_repeater(dev, 1);
+	r = rtlsdr_r82xx_gain_fast(dev, gain);
+	rtlsdr_set_i2c_repeater(dev, 0);
+	dev->i2c_in_lazy = 0;
+	pthread_mutex_unlock(&dev->cs_mutex);
+	return r;
+}
+
+int rtlsdr_set_center_freq_gain_fast(rtlsdr_dev_t *dev, uint32_t freq, int gain, int flags)
+{
+	int r, rg;
+
+	#ifdef _ENABLE_RPC
+	if (rtlsdr_rpc_is_enabled())
+	{
+	  r = rtlsdr_rpc_set_center_freq(dev, freq);
+	  rg = rtlsdr_rpc_set_tuner_gain(dev, gain);
+	  return r < 0 ? r : rg;
+	}
+	#endif
+	if (!dev || !dev->tuner)
+		return -1;
+	if (!rtlsdr_fast_tune_applies(dev)) {
+		r = rtlsdr_set_center_freq_fast(dev, freq, flags);
+		rg = rtlsdr_set_tuner_gain(dev, gain);
+		return r < 0 ? r : rg;
+	}
+
+	pthread_mutex_lock(&dev->cs_mutex);	/* recursive: the tune takes it again */
+	r = rtlsdr_set_center_freq_fast(dev, freq, flags);
+	/* the gain straight after the tune, in the same hold of the I2C
+	 * repeater: the tune's last transfer went to the tuner a moment ago, so
+	 * no dummy read is needed in front (a write is made only for what
+	 * changed). The repeater is switched on again only if the tune's I2C
+	 * failed (rtlsdr_i2c_read / _write cleared i2c_repeater_on). */
+	if (dev->i2c_repeater_on) {
+		rg = rtlsdr_r82xx_gain_fast(dev, gain);
+	} else {
+		rtlsdr_set_i2c_repeater(dev, 1);
+		rg = rtlsdr_r82xx_gain_fast(dev, gain);
+		rtlsdr_set_i2c_repeater(dev, 0);
+	}
+	pthread_mutex_unlock(&dev->cs_mutex);
+	return r < 0 ? r : rg;
+}
+
 int rtlsdr_is_tuner_PLL_locked(rtlsdr_dev_t *dev)
 {
 	int r = -1;
diff --git a/src/tuner_r82xx.c b/src/tuner_r82xx.c
index 97cff07..d1977f2 100644
--- a/src/tuner_r82xx.c
+++ b/src/tuner_r82xx.c
@@ -1767,6 +1767,48 @@ int r82xx_set_gain(struct r82xx_priv *priv, int set_manual_gain, int gain,
 	return rc;
 }
 
+/* rtlsdr_set_tuner_gain_fast() / rtlsdr_set_center_freq_gain_fast(): the
+ * manual gain r82xx_set_gain(priv, 1, gain, ...) sets - the same table and
+ * rounding (r82xx_get_rf_gain_index), the same cache and last_* values, the
+ * IF VGA left as it is - without that call's read of registers 0..3 (its
+ * result is not used) and with the LNA (0x05) and mixer (0x07) gains in ONE
+ * I2C write of 0x05..0x07 when both change (0x06 goes out with its cached
+ * value); one of them changed: that register alone; neither: no transfer.
+ * Not in manual gain mode (AGC, extended mode): the ordinary path, which
+ * switches to manual as rtlsdr_set_tuner_gain() does. */
+int r82xx_set_gain_fast(struct r82xx_priv *priv, int gain, int *rtl_vga_control)
+{
+	int rc = 0, lna = 0, mix = 0, ch5, ch7;
+	uint8_t v[3];
+
+	if (!priv->last_manual_gain || priv->last_extended_mode)
+		return r82xx_set_gain(priv, 1, gain, 0, 0, 0, 0, rtl_vga_control);
+
+	r82xx_get_rf_gain_index(gain, &lna, &mix);
+	/* 0x05: bit 4 set = LNA manual, [3:0] LNA; 0x07: bit 4 clear = mixer manual, [3:0] mixer */
+	v[0] = (uint8_t)((r82xx_read_cache_reg(priv, 0x05) & ~0x1f) | 0x10 | (lna & 0x0f));
+	v[1] = (uint8_t)r82xx_read_cache_reg(priv, 0x06);
+	v[2] = (uint8_t)((r82xx_read_cache_reg(priv, 0x07) & ~0x1f) | (mix & 0x0f));
+	ch5 = r82xx_reg_changed(priv, 0x05, v[0]);
+	ch7 = r82xx_reg_changed(priv, 0x07, v[2]);
+	if (ch5 && ch7)
+		rc = r82xx_write_arr(priv, 0x05, v, 3);
+	else if (ch5)
+		rc = r82xx_write_arr(priv, 0x05, &v[0], 1);
+	else if (ch7)
+		rc = r82xx_write_arr(priv, 0x07, &v[2], 1);
+	if (rc < 0)
+		return rc;	/* write_arr marked what may not have gone out unsynced */
+
+	priv->last_manual_gain = 1;
+	priv->last_extended_mode = 0;
+	priv->last_LNA_value = lna;
+	priv->last_Mixer_value = mix;
+
+	/* the IF VGA as r82xx_set_gain() leaves it (only written if it differs) */
+	return r82xx_set_if_mode_reg(priv, priv->last_if_mode, rtl_vga_control, 0);
+}
+
 int r82xx_get_rf_gain(struct r82xx_priv *priv)
 {
 	int lna_gain = r82xx_get_lna_gain_from_index(priv->last_LNA_value);
-- 
2.34.1

