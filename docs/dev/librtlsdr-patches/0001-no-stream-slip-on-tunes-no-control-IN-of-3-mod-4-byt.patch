From e6336018cb57ebae3a2c8a18af2201d9fdc174f1 Mon Sep 17 00:00:00 2001
From: Carl <admin@rtl-sdr.com>
Date: Sat, 21 Nov 2026 03:36:17 +1300
Subject: [PATCH] no stream slip on tunes: no control IN of 3 mod 4 bytes,
 settle big VCO jumps, NO_DUMMY_READ flag

Every USB control IN whose data stage is 3, 7, 11 ... bytes long makes the
RTL2832U drop 4 bytes (2 I/Q samples) of its running bulk stream - any block,
even a standard GET_DESCRIPTOR. The R820T PLL lock check read 3 tuner
registers on every tune, so each retune shifted that dongle's samples by 2
against every other dongle (unequal retunes broke coherent arrays).
Measured on a KrakenSDR (x86_64 Linux): -2.000 samples per transfer for
lengths 3..63 step 4, 0.000 for every other length and every write.

- rtlsdr_ctrl_transfer_retry pads such an IN by one byte (bounce buffer).
- the lock check (set_pll, set_pll_yc, finish_tune) reads 4 registers
  (R82XX_LOCK_READ_LEN): early lock reads (settle wait shortened) corrupt
  0x0b (4 or 5 bytes) / 0x0c (5) and 0x1b / 0x1c (any length, 3 too);
  with the 5000 us settle none came early in 56000 + 28000 tunes.
- the settle wait also after a VCO jump of > 400 MHz inside one divider and
  band (R82XX_PLL_SETTLE_VCO_JUMP_KHZ): random tunes read the lock early in
  3.3 % of cases (all jumps > 400 MHz in the top divider), 0 with it.
- RTLSDR_NO_STREAM_SLIP in rtl-sdr.h tells applications.
- RTLSDR_TUNE_NO_DUMMY_READ (rtlsdr_set_center_freq_fast flag): the dummy
  demod read in front of a tuner access only if its first transfer is a
  write; a same-band KEEP_AUTOTUNE hop 4 -> 3 transfers (9.8 -> 7.5 ms).

Measured: lag probe 0.000 samples per tune for every pattern (thousands of
tunes, each of five dongles), a raw 3-byte IN as control -2.000.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01VjXPtpwEy1fc9vNmq4LmHQ
---
 include/rtl-sdr.h     | 26 +++++++++++++++
 include/tuner_r82xx.h |  3 +-
 src/librtlsdr.c       | 74 +++++++++++++++++++++++++++++++++++++------
 src/tuner_r82xx.c     | 53 ++++++++++++++++++++++++++-----
 4 files changed, 138 insertions(+), 18 deletions(-)

diff --git a/include/rtl-sdr.h b/include/rtl-sdr.h
index e1e6e90..42d6c7d 100755
--- a/include/rtl-sdr.h
+++ b/include/rtl-sdr.h
@@ -185,6 +185,7 @@ RTLSDR_API int rtlsdr_set_center_freq64(rtlsdr_dev_t *dev, uint64_t freq);
 /* rtlsdr_set_center_freq_fast() flags */
 #define RTLSDR_TUNE_KEEP_AUTOTUNE	0x01
 #define RTLSDR_TUNE_SPAN_AUTOTUNE	0x04
+#define RTLSDR_TUNE_NO_DUMMY_READ	0x08
 
 /*!
  * Retune for a drag (a run of retunes close together): as
@@ -197,6 +198,13 @@ RTLSDR_API int rtlsdr_set_center_freq64(rtlsdr_dev_t *dev, uint64_t freq);
  *    rtlsdr_finish_tune() once the drag is over.
  *  RTLSDR_TUNE_SPAN_AUTOTUNE: the 128 kHz clock goes out in the I2C write
  *    of N / SDM (0x14..0x1a) instead of a write of its own before them.
+ *  RTLSDR_TUNE_NO_DUMMY_READ (any tuner): outside Windows every tuner access
+ *    starts with a dummy demod read, so that no control OUT comes first after
+ *    a quiet spell (it stalls); with this flag that read is made only if the
+ *    tune's first I2C transfer is a write - a tune that starts with a tuner
+ *    read (a same-band step with KEEP_AUTOTUNE: the register-4 read) has
+ *    its control IN in front already: 1 USB transfer less (Windows makes no
+ *    dummy read anyway).
  * (0x02 is not used.) flags 0 = rtlsdr_set_center_freq().
  *
  * \param dev the device handle given by rtlsdr_open()
@@ -222,6 +230,24 @@ RTLSDR_API int rtlsdr_set_center_freq_fast(rtlsdr_dev_t *dev, uint32_t freq, int
  */
 RTLSDR_API int rtlsdr_finish_tune(rtlsdr_dev_t *dev);
 
+/*
+ * Defined when no USB control transfer of this library drops samples from a
+ * running stream (rtlsdr_read_async / rtlsdr_read_sync): a retune
+ * (rtlsdr_set_center_freq, _fast, rtlsdr_finish_tune), a gain or IF mode
+ * change, a GPIO / bias tee write or a register read leaves the stream's
+ * sample count intact, so dongles streaming together stay in step whatever
+ * each is told. Measured on a KrakenSDR (five R820T): the RTL2832U drops 4
+ * bytes (2 I/Q samples) of its bulk stream for every USB control IN whose
+ * data stage is 3, 7, 11 ... bytes long - the R820T's PLL lock check (a
+ * read of 3 tuner registers on every tune) shifted a retuned dongle's
+ * stream by 2 samples a tune against the others. This library makes no IN
+ * of such a length (librtlsdr.c, rtlsdr_ctrl_transfer_retry). What moves a
+ * stream on purpose: rtlsdr_set_sample_freq_correction* (the sample clock);
+ * not measured: the calls that reset the demodulator (sample rate, direct
+ * sampling, test / AGC modes) and rtlsdr_reset_buffer while streaming.
+ */
+#define RTLSDR_NO_STREAM_SLIP 1
+
 /*!
  * Set harmonic reception - for R820T/2 tuner
  *
diff --git a/include/tuner_r82xx.h b/include/tuner_r82xx.h
index ae122b6..7d19e93 100755
--- a/include/tuner_r82xx.h
+++ b/include/tuner_r82xx.h
@@ -85,7 +85,8 @@ struct r82xx_priv {
 	uint8_t						regs[NUM_REGS];
 	uint32_t					regs_unsynced;	/* bit n: the chip may not hold regs[n] */
 	int							mux_range;		/* freq_ranges[] index of the last r82xx_set_mux, -1 = none */
-	uint8_t						pll_settle;		/* next lock read waits R82XX_PLL_SETTLE_US (divider / band changed) */
+	uint8_t						pll_settle;		/* next lock read waits R82XX_PLL_SETTLE_US (divider / band changed, a big VCO jump) */
+	uint32_t					last_vco_khz;	/* VCO of the last tune (0 = none): R82XX_PLL_SETTLE_VCO_JUMP_KHZ */
 	uint8_t						tune_flags;		/* R82XX_TUNE_* of the rtlsdr_set_center_freq_fast() call running */
 	uint8_t						tune_pending;	/* PLL autotune clock (maybe) still at 128 kHz: r82xx_finish_tune() */
 	uint8_t						buf[NUM_REGS + 1];
diff --git a/src/librtlsdr.c b/src/librtlsdr.c
index 2eb57e2..0b955aa 100644
--- a/src/librtlsdr.c
+++ b/src/librtlsdr.c
@@ -89,13 +89,42 @@ typedef int socklen_t;
  * open: 4 stalls per dongle with an R820T - on Linux now 6 more writes and
  * 6 more dummy reads per dongle, measured on the Pi 5; a busy EEPROM, not
  * measured): it is
- * retried and, if it persists, returned unchanged. */
+ * retried and, if it persists, returned unchanged.
+ *
+ * And no control IN has a data stage of 3, 7, 11 ... bytes (length % 4 ==
+ * 3): each such transfer makes the RTL2832U drop 4 bytes - 2 I/Q samples -
+ * from its running bulk stream, so that dongle's samples shift against every
+ * other's (RTLSDR_NO_STREAM_SLIP in rtl-sdr.h). Measured on a KrakenSDR
+ * (2026-11-21, x86_64 Linux, three dongles streaming, the lag of the
+ * operated one against the others by cross-correlation, 100 transfers each):
+ * -2.000 samples per transfer for lengths 3, 7, 11, 15, 19, 23, 27, 31, 35,
+ * 63 - any vendor block (USB, SYS, demod, I2C to the tuner or the EEPROM)
+ * and the standard GET_DESCRIPTOR alike, also at 1.2 MS/s (a byte count, not
+ * time); 0.000 for 1, 2, 4, 5, 6, 8, 9, 10, 12, 13, 14, 16, 64, for every
+ * write, and for a read that failed (no data stage). Such a read is made one
+ * byte longer into a bounce buffer and the caller gets its own bytes: the
+ * one more register (or tuner / EEPROM byte) read has no effect - none of
+ * the library's reads is of a register that changes when read. (The R820T
+ * PLL lock check read 3 tuner registers on every tune: 2 samples a tune.) */
+#define RTLSDR_CTRL_IN_PAD_MAX	255
 static int rtlsdr_ctrl_transfer_retry(libusb_device_handle *devh, uint8_t request_type,
 	uint8_t request, uint16_t value, uint16_t index, unsigned char *data, uint16_t length,
 	unsigned int timeout)
 {
-	int r = libusb_control_transfer(devh, request_type, request, value, index, data, length, timeout);
-	int i;
+	int r, i;
+
+	if ((request_type & LIBUSB_ENDPOINT_IN) && (length & 3) == 3 && length <= RTLSDR_CTRL_IN_PAD_MAX) {
+		unsigned char bounce[RTLSDR_CTRL_IN_PAD_MAX + 1];
+
+		r = libusb_control_transfer(devh, request_type, request, value, index, bounce, length + 1, timeout);
+		if (r > (int)length)
+			r = length;
+		if (r > 0)
+			memcpy(data, bounce, r);
+		return r;	/* (an IN is never retried) */
+	}
+
+	r = libusb_control_transfer(devh, request_type, request, value, index, data, length, timeout);
 	for (i = 0; i < 3 && r == LIBUSB_ERROR_PIPE && !(request_type & LIBUSB_ENDPOINT_IN); i++) {
 		unsigned char dummy[2];
 		libusb_control_transfer(devh, LIBUSB_REQUEST_TYPE_VENDOR | LIBUSB_ENDPOINT_IN, 0,
@@ -429,12 +458,18 @@ struct rtlsdr_dev {
 	volatile LONG xfer_inflight;
 #endif
 	int i2c_repeater_on;
+	/* RTLSDR_TUNE_NO_DUMMY_READ (rtlsdr_set_i2c_repeater): the tune running
+	 * leaves the dummy demod read to its first I2C write (i2c_in_due), and
+	 * none is made if a tuner read comes first */
+	int i2c_in_lazy;
+	int i2c_in_due;
 	int rc_active;
 	int verbose;
 	int dev_num;
 };
 
 static int rtlsdr_demod_write_reg(rtlsdr_dev_t *dev, uint8_t page, uint16_t addr, uint16_t val, uint8_t len);
+uint16_t rtlsdr_demod_read_reg(rtlsdr_dev_t *dev, uint8_t page, uint16_t addr, uint8_t len);
 static int rtlsdr_set_if_freq(rtlsdr_dev_t *dev, uint32_t freq);
 static int rtlsdr_update_ds(rtlsdr_dev_t *dev, uint64_t freq);
 static int rtlsdr_set_spectrum_inversion(rtlsdr_dev_t *dev, int sideband);
@@ -1018,6 +1053,12 @@ int rtlsdr_i2c_write(rtlsdr_dev_t *dev, uint8_t i2c_addr, uint8_t *buffer, int l
 	if (!dev)
 		return -1;
 
+	/* the dummy read RTLSDR_TUNE_NO_DUMMY_READ left to the first write */
+	if (dev->i2c_in_due) {
+		dev->i2c_in_due = 0;
+		rtlsdr_demod_read_reg(dev, 0x0a, 0x01, 1);
+	}
+
 	/* failed: the next tuner access writes the I2C repeater on again
 	 * (it stays on between accesses - rtlsdr_set_i2c_repeater) */
 	r = rtlsdr_write_array(dev, IICB, addr, buffer, len);
@@ -1034,6 +1075,7 @@ int rtlsdr_i2c_read(rtlsdr_dev_t *dev, uint8_t i2c_addr, uint8_t *buffer, int le
 	if (!dev)
 		return -1;
 
+	dev->i2c_in_due = 0;	/* this read is the control IN in front */
 	r = rtlsdr_read_array(dev, IICB, addr, buffer, len);
 	if (r < 0)
 		dev->i2c_repeater_on = 0;	/* as in rtlsdr_i2c_write */
@@ -1253,13 +1295,23 @@ void rtlsdr_set_i2c_repeater(rtlsdr_dev_t *dev, int on)
 		 * every platform (rtlsdr_ctrl_transfer_retry): that covers a pause
 		 * inside a tuner access (>= 300 ms stalled the next write here),
 		 * this read the start of one. Windows has only the retry - a
-		 * transfer only when one is needed. */
-		rtlsdr_demod_read_reg(dev, 0x0a, 0x01, 1);
+		 * transfer only when one is needed.
+		 * RTLSDR_TUNE_NO_DUMMY_READ: what matters is a control IN before
+		 * the access's first control OUT, and a tuner read is one - the
+		 * read is made only if an I2C write comes first (rtlsdr_i2c_write),
+		 * so a sweep's same-band hop, which starts with the register-4
+		 * read, makes one transfer less. */
+		if (dev->i2c_in_lazy)
+			dev->i2c_in_due = 1;
+		else
+			rtlsdr_demod_read_reg(dev, 0x0a, 0x01, 1);
 	}
 #endif
 
-	if (!on)
+	if (!on) {
+		dev->i2c_in_due = 0;
 		pthread_mutex_unlock(&dev->cs_mutex);
+	}
 }
 
 int rtlsdr_set_fir(rtlsdr_dev_t *dev)
@@ -1764,13 +1816,17 @@ int rtlsdr_set_center_freq_fast(rtlsdr_dev_t *dev, uint32_t freq, int flags)
 	if (!dev || !dev->tuner)
 		return -1;
 
-	flags &= RTLSDR_TUNE_KEEP_AUTOTUNE | RTLSDR_TUNE_SPAN_AUTOTUNE;
-	if (!flags || !rtlsdr_fast_tune_applies(dev))
+	flags &= RTLSDR_TUNE_KEEP_AUTOTUNE | RTLSDR_TUNE_SPAN_AUTOTUNE | RTLSDR_TUNE_NO_DUMMY_READ;
+	if (!rtlsdr_fast_tune_applies(dev))
+		flags &= RTLSDR_TUNE_NO_DUMMY_READ;
+	if (!flags)
 		return rtlsdr_set_center_freq(dev, freq);
 
 	pthread_mutex_lock(&dev->cs_mutex);	/* recursive: the tune takes it again */
-	dev->r82xx_p.tune_flags = (uint8_t)flags;
+	dev->r82xx_p.tune_flags = (uint8_t)(flags & (RTLSDR_TUNE_KEEP_AUTOTUNE | RTLSDR_TUNE_SPAN_AUTOTUNE));
+	dev->i2c_in_lazy = (flags & RTLSDR_TUNE_NO_DUMMY_READ) != 0;
 	r = rtlsdr_set_center_freq(dev, freq);
+	dev->i2c_in_lazy = 0;
 	dev->r82xx_p.tune_flags = 0;
 	pthread_mutex_unlock(&dev->cs_mutex);
 	return r;
diff --git a/src/tuner_r82xx.c b/src/tuner_r82xx.c
index 4b2b24b..2cda5df 100644
--- a/src/tuner_r82xx.c
+++ b/src/tuner_r82xx.c
@@ -65,6 +65,33 @@
  * (same divider, same band) don't wait. */
 #define R82XX_PLL_SETTLE_US	5000
 
+/* ... and after a tune that moved the VCO by more than this within one
+ * divider and band. Measured on the KrakenSDR (2026-11-21, random
+ * frequencies 24-1766 MHz, 5 dongles): without it 3.3-3.5 % of all tunes
+ * read the lock before the PLL had settled (a lock retry; 1-4 left 0x0b =
+ * 0xff, some 0x1b / 0x1c corrupted - the stream ~30 dB weaker), every one
+ * a jump of more than 400 MHz (VCO > 800 MHz) in the top divider (RF
+ * 885-1766 MHz, all one band, so no settle); 0 retries in 4597 same-divider
+ * jumps of less than 400 MHz (any divider; 790 of 300-400 MHz in the top
+ * one, VCO 600-800 MHz). 400 MHz of VCO = half of that: a
+ * sweep's hops (2.4 MHz RF, at most 154 MHz VCO at 24 MHz) never wait. */
+#define R82XX_PLL_SETTLE_VCO_JUMP_KHZ	400000
+
+/* The PLL lock check (r82xx_set_pll, r82xx_set_pll_yc, r82xx_finish_tune)
+ * reads registers 0..3; the lock bit is in register 2. It read 0..2 (as
+ * osmocom does), but every USB control IN of 3 bytes makes the RTL2832U
+ * drop 4 bytes - 2 I/Q samples - from its running stream, so each tune
+ * moved that dongle's samples against the other dongles'
+ * (rtlsdr_ctrl_transfer_retry in librtlsdr.c, RTLSDR_NO_STREAM_SLIP). 4,
+ * not 5: a lock read that comes before the PLL has settled (the settle
+ * wait above too short - provoked with it at 0 / 1500 us) can leave 0x0b
+ * (4 or 5 bytes read) and 0x0c (5) at 0xff on the chip - never seen with
+ * 3 - and 0x1b / 0x1c corrupted (any length, 3 too: the stream ~30 dB
+ * weaker until they are rewritten); with the 5000 us wait no lock read came
+ * early in 2026-11-21's KrakenSDR runs (docs/dev/librtlsdr-fork.md of the
+ * KrakenSDR suite). */
+#define R82XX_LOCK_READ_LEN	4
+
 #ifdef _WIN32
 #include <windows.h>
 static void r82xx_settle_wait(unsigned int us)
@@ -1000,10 +1027,10 @@ static int r82xx_set_pll_yc(struct r82xx_priv *priv, uint32_t freq)
 /***/
 
   /* Check if PLL has locked */
-  rc = r82xx_read(priv, 0x00, data, 3);
+  rc = r82xx_read(priv, 0x00, data, R82XX_LOCK_READ_LEN);
   if (rc < 0) {
       if (priv->cfg->verbose)
-        fprintf(stderr, "r82xx_set_pll_yc(): error reading 'pll lock status' from i2c reg 0x00..0x02\n");
+        fprintf(stderr, "r82xx_set_pll_yc(): error reading 'pll lock status' from i2c reg 0x00..0x03\n");
     return rc;
   }
   if (!(data[2] & 0x40)) {
@@ -1155,6 +1182,17 @@ static int r82xx_set_pll(struct r82xx_priv *priv, uint32_t freq)
 
 	vco_freq = (uint64_t)freq * (uint64_t)mix_div;
 
+	/* a big VCO jump inside one divider and band waits before the lock read
+	 * too (R82XX_PLL_SETTLE_VCO_JUMP_KHZ) */
+	{
+		uint32_t vco_khz = (uint32_t)(vco_freq / 1000);
+		uint32_t jump = vco_khz > priv->last_vco_khz ? vco_khz - priv->last_vco_khz : priv->last_vco_khz - vco_khz;
+
+		if (!priv->last_vco_khz || jump > R82XX_PLL_SETTLE_VCO_JUMP_KHZ)
+			priv->pll_settle = 1;
+		priv->last_vco_khz = vco_khz;
+	}
+
 	/*
 	 * We want to approximate:
 	 *
@@ -1249,13 +1287,12 @@ static int r82xx_set_pll(struct r82xx_priv *priv, uint32_t freq)
 
 	for (i = 0; i < 2; i++) {
 
-		/* Check if PLL has locked - registers 0..2 only, as osmocom: reading
-		 * 3 / 4 too while the PLL settled after a divider change was
-		 * followed by the 0x0b / 0x0c corruption (see R82XX_PLL_SETTLE_US) */
-		rc = r82xx_read(priv, 0x00, data, 3);
+		/* Check if PLL has locked - registers 0..3 (R82XX_LOCK_READ_LEN:
+		 * a 3-byte read drops 2 samples of the stream) */
+		rc = r82xx_read(priv, 0x00, data, R82XX_LOCK_READ_LEN);
 		if (rc < 0) {
 			if (priv->cfg->verbose)
-				fprintf(stderr, "r82xx_set_pll(): error reading 'pll lock status' from i2c reg 0x00 .. 0x02\n");
+				fprintf(stderr, "r82xx_set_pll(): error reading 'pll lock status' from i2c reg 0x00 .. 0x03\n");
 			return rc;
 		}
 		if ( (data[2] & 0x40) || vco_curr_max == vco_curr_min )
@@ -1312,7 +1349,7 @@ static int r82xx_set_pll(struct r82xx_priv *priv, uint32_t freq)
  * the full path), < 0 = I2C error */
 int r82xx_finish_tune(struct r82xx_priv *priv)
 {
-	uint8_t data[3];
+	uint8_t data[R82XX_LOCK_READ_LEN];
 	int rc;
 
 	if (!priv->tune_pending)
