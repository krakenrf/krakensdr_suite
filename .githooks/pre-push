#!/bin/bash
#
# pre-push: block pushes whose OUTGOING commits contain station secrets
# (KrakenPro key, real lat/lon), a settings file that should never be
# tracked, or a private key of the web UI's HTTPS certificate (server.key,
# the receiver's CA key krakensdr-ca.key, an unusable key moved aside
# *.unreadable-*, a replaced CA's key kept *.retired-*, a temporary
# *.key.tmp, make-cert.sh's .make-cert.* folders
# - .gitignore keeps them out, this catches a `git add -f`). Backstop behind the clean filter (scripts/git-secrets-clean),
# which sanitizes these automatically at commit time - this hook only fires
# if the filter was not configured (fresh clone before install.sh) or a
# secret landed some other way. Also blocks binaries and user-built voice
# codecs (licensing - backstop behind .gitignore, see scan_range), and
# recognisable map provider API keys added to ANY file (MAP_KEY_AWK: what it
# does and doesn't recognise; mark a legitimate line with map-key-ok).
#
# Activated per clone by install.sh:  git config core.hooksPath .githooks
# Emergency bypass:                   git push --no-verify
#
set -u

fail=0
codec_fail=0
mapkey_fail=0

# Map provider API keys (the web UI's ⚙ Settings), in an ADDED line:
#  - a Google key: AIza + 35 key characters, anywhere;
#  - a Mapbox token: pk. / sk. / tk.eyJ... (a JWT), anywhere;
#  - a key in a URL query: ?access_token= &apikey= &api_key= &key=
#    &subscription-key= followed by 20+ key characters;
#  - a provider entry of the page's localStorage kraken_map_prov, one-line or
#    pretty-printed: "mapbox" / "google" / "azure" / "maptiler" /
#    "thunderforest" / "stadia" / "here" / "custom" : "<16+ key characters>".
# A value counts as a key only if it looks random: it has a digit and a
# letter, and is not a placeholder (YOUR..., EXAMPLE, XXXX, an ALL_CAPS or
# snake_case name); "${c.k}" / "{key}" templates never match. NOT
# recognisable: a bare Azure / HERE / MapTiler / Thunderforest / Stadia key in
# any other context - those are plain random strings.
# A line containing the marker map-key-ok is never reported.
MAP_KEY_OK='map-key-ok'
# awk input: a (combined) diff; output: "path:line: masked key" per hit.
# Plain POSIX awk (no {n} intervals: macOS's awk and mawk lack them)
MAP_KEY_AWK='
function placeholder(v,  lv, u) {
    lv = tolower(v)
    if (lv ~ /your|example|xxxx|placeholder|insert|replace/) return 1
    u = v; if (v ~ /^[A-Z0-9_]+$/ && gsub(/_/, "", u) >= 1) return 1
    u = v; if (v ~ /^[a-z0-9_]+$/ && gsub(/_/, "", u) >= 2) return 1
    return 0
}
function keylike(v, minlen) {
    return length(v) >= minlen && v ~ /[0-9]/ && v ~ /[A-Za-z]/ && !placeholder(v)
}
function hit(tok) { print f ":" ln ": " substr(tok, 1, 6) "..."; found = 1 }
function check(s,  t, v, r) {
    if (index(s, marker)) return
    found = 0
    t = s; while (match(t, /AIza[0-9A-Za-z_-]+/)) {
        v = substr(t, RSTART, RLENGTH); t = substr(t, RSTART + RLENGTH)
        if (length(v) >= 39 && !placeholder(v)) { hit(v); return } }
    t = s; while (match(t, /[pst]k\.eyJ[0-9A-Za-z_-]+\.[0-9A-Za-z_-]+/)) {
        v = substr(t, RSTART, RLENGTH); t = substr(t, RSTART + RLENGTH)
        if (length(v) >= 37 && !placeholder(v)) { hit(v); return } }
    t = s; while (match(t, /[?&](access_token|[Aa][Pp][Ii]_?[Kk][Ee][Yy]|subscription-key|key)=[0-9A-Za-z_-]+/)) {
        r = substr(t, RSTART, RLENGTH); t = substr(t, RSTART + RLENGTH)
        v = substr(r, index(r, "=") + 1)
        if (keylike(v, 20)) { hit(v); return } }
    t = s; while (match(t, /"(mapbox|google|azure|maptiler|thunderforest|stadia|here|custom)"[ \t]*:[ \t]*"[0-9A-Za-z_.-]+"/)) {
        r = substr(t, RSTART, RLENGTH - 1); t = substr(t, RSTART + RLENGTH)
        v = r; sub(/^.*"/, "", v)
        if (keylike(v, 16)) { hit(v); return } }
}
/^diff --git / { f = $0; sub(/^diff --git a\//, "", f); n = index(f, " b/"); if (n) f = substr(f, n + 3); np = 1; hdr = 1; next }
/^diff --(cc|combined) / { f = $0; sub(/^diff --(cc|combined) /, "", f); hdr = 1; next }
/^@@/ {
    np = 0; while (substr($0, np + 1, 1) == "@") np++
    np--; ln = 0
    for (i = 2; i <= NF; i++) if (substr($i, 1, 1) == "+") { x = substr($i, 2); sub(/,.*/, "", x); ln = x + 0; break }
    hdr = 0; next
}
hdr { next }
{
    p = substr($0, 1, np)
    if (length(p) < np || p ~ /[^+ ]/) next
    if (p !~ / /) check(substr($0, np + 1))
    ln++
}'
# end MAP_KEY_AWK

# Scan the commits selected by the rev-list arguments ("$@", passed as
# SEPARATE words - e.g. "$sha" --not --remotes) for secrets in changed
# settings/config files. Returns nonzero if the range can't be resolved, so
# the caller can fail closed instead of silently scanning nothing.
scan_range() {
    local commits
    commits=$(git rev-list "$@" 2>/dev/null) || return 1
    local c f blob
    for c in $commits; do
        # Only files that can carry station config are inspected, so ordinary
        # source/doc changes can never false-positive. --root: a root commit
        # (first commit of a new history) has no parent to diff against and
        # listed nothing without it. -m: a merge commit listed nothing either,
        # so a secret added while resolving a merge slipped through; -m diffs
        # it against each parent (sort -u drops the duplicates). NUL-separated
        # so a path with spaces stays one path.
        while IFS= read -r -d '' f; do
            # A path the commit DELETES is listed too: nothing to leak, and
            # blocking it rejected the very commit that untracks a secret file
            git cat-file -e "$c:$f" 2>/dev/null || continue
            case "$f" in
                *doa_settings.json|*api_token)
                    echo "BLOCKED: $f is committed in ${c:0:9} - this file holds" >&2
                    echo "         the KrakenPro key / station location and must stay untracked." >&2
                    fail=1
                    continue
                    ;;
                # the web UI's private keys (kraken_doa_v2/docs/dev/https-certificate.md,
                # fine rule 21): whoever has the receiver's CA key can
                # impersonate it - in wide scope any .local / .lan name and
                # private address - to every device that installed its
                # certificate. Also a key moved aside, a replaced CA's key
                # kept (fine rule 32: krakensdr-ca.key.retired-YYYYMMDD,
                # usually an unconstrained CA), a temporary one, and anything
                # in make-cert.sh's work folders
                krakensdr-ca.key|*/krakensdr-ca.key|server.key|*/server.key|\
                *.unreadable-*|*.retired-*|*.key.tmp|.make-cert.*|*/.make-cert.*)
                    echo "BLOCKED: $f is committed in ${c:0:9} - a private key of the web UI's" >&2
                    echo "         HTTPS certificate; it must stay untracked." >&2
                    fail=1
                    continue
                    ;;
            esac
            blob=$(git show "$c:$f" 2>/dev/null) || continue
            if echo "$blob" | grep -Eq '"(krakenpro_key|web_mapper_key)"[[:space:]]*:[[:space:]]*"[^"]{6,}"'; then
                echo "BLOCKED: KrakenPro API key found in $f at commit ${c:0:9}." >&2
                fail=1
            fi
            if echo "$blob" | grep -Eq '"(latitude|longitude)"[[:space:]]*:[[:space:]]*-?(0*[1-9][0-9]*|0*\.0*[1-9])'; then
                echo "BLOCKED: real latitude/longitude found in $f at commit ${c:0:9}." >&2
                fail=1
            fi
            if echo "$blob" | grep -E '"static_location"[[:space:]]*:' | grep -Evq '"(0, *0, *0|0,0,0)?"'; then
                echo "BLOCKED: real static_location found in $f at commit ${c:0:9}." >&2
                fail=1
            fi
        done < <(git diff-tree --root -m --no-commit-id --name-only -r -z "$c" -- \
                     '*config.json' '*doa_settings.json' '*settings*.json' \
                     '*api_token' '*krakensdr-ca.key' '*server.key' \
                     '*.unreadable-*' '*.retired-*' '*.key.tmp' '*.make-cert.*' | sort -zu)
        # Voice codecs are never distributed (the ETSI TETRA codec may not be
        # redistributed, AMBE is DVSI's): a user-built codec program or
        # library, the ETSI zip or its sources (osmo-tetra's codec/ folder),
        # and any Windows exe / DLL - every program of the suite is built from
        # source, so a committed one is a build output or someone's binary.
        # Backstop behind .gitignore (a `git add -f` gets past that)
        while IFS= read -r -d '' f; do
            git cat-file -e "$c:$f" 2>/dev/null || continue
            # lower case with tr, not ${f,,}: macOS's bash is 3.2, where that
            # is a "bad substitution" that ended the scan - and the push went
            # ahead unscanned
            local lf
            lf=$(printf '%s' "$f" | tr '[:upper:]' '[:lower:]')
            local base="${lf##*/}"
            case "$base" in
                cdecoder|sdecoder|ccoder|scoder|tetra-cdecoder|tetra-sdecoder|\
                *.exe|*.dll|libmbe.so*|libmbe*.dylib|libfdk-aac*.so*|libfdk-aac*.dylib|etsi_tetra_codec.zip|en_30039502*.zip)
                    echo "BLOCKED: $f is committed in ${c:0:9} - a binary / voice codec file" >&2
                    echo "         that must not go to the remote (README: Digital voice codecs)." >&2
                    codec_fail=1
                    continue
                    ;;
            esac
            case "/$lf" in
                */osmo-tetra/codec/*|*/c-code/cdecoder.c|*/c-code/sdecoder.c|*/c-code/scod_tet.c)
                    echo "BLOCKED: $f is committed in ${c:0:9} - the ETSI TETRA codec's source" >&2
                    echo "         may not be redistributed." >&2
                    codec_fail=1
                    ;;
            esac
        done < <(git diff-tree --root -m --no-commit-id --name-only -r -z "$c" | sort -zu)
        # Map provider API keys: the page keeps them in the browser's
        # localStorage, never in a file - this catches one pasted into code,
        # a doc, a test, a settings or HAR dump. Every file, but only the
        # lines the commit ADDS, so content already on the remote can't
        # block a push. The path comes from "diff --git"; "+++" counts as a
        # file header only before the first hunk (an added line "++ x" is
        # content). Binary files show no lines.
        # -c (combined diff): a merge commit shows only the lines that are
        # new relative to EVERY parent ("+" in each parent's column), so a
        # key the merged branch brought in - already on the remote, or
        # caught in that branch's own outgoing commits - doesn't block the
        # merge, but one typed while resolving a conflict does. Works for any
        # number of parents; a non-merge or root commit gets a normal diff.
        local diff hits
        if ! diff=$(git diff-tree --root -c -p -r -U0 --no-color --no-ext-diff --no-textconv "$c" 2>/dev/null); then
            echo "BLOCKED: could not diff commit ${c:0:9} for map provider API keys - not scanned." >&2
            mapkey_fail=1
            continue
        fi
        hits=$(printf '%s\n' "$diff" | awk -v marker="$MAP_KEY_OK" "$MAP_KEY_AWK")
        if [ -n "$hits" ]; then
            while IFS= read -r f; do
                echo "BLOCKED: a map provider API key at $f (commit ${c:0:9})." >&2
            done <<< "$hits"
            mapkey_fail=1
        fi
    done
    return 0
}

# stdin: <local_ref> <local_sha> <remote_ref> <remote_sha> per ref being pushed
zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue      # branch deletion: nothing outgoing
    if [ "$remote_sha" = "$zero" ]; then
        # New remote branch: scan commits not already on any remote.
        scan_range "$local_sha" --not --remotes || scan_failed=1
    else
        # Update: scan what's new since the remote tip and not already on
        # THIS remote ($1; merging origin/main into a branch brings main's
        # commits, which are there already - a commit that is only on some
        # other remote is still scanned). If that tip isn't in this clone
        # (e.g. a force-push over commits never fetched), fall back to
        # everything not already on a remote.
        scan_range "$local_sha" --not "$remote_sha" --remotes="${1:-}" ||
            scan_range "$local_sha" --not --remotes || scan_failed=1
    fi
    if [ "${scan_failed:-0}" -ne 0 ]; then
        echo "BLOCKED: could not list the outgoing commits for $local_ref - not scanned." >&2
        fail=1
        scan_failed=0
    fi
done

if [ "$codec_fail" -ne 0 ]; then
    echo >&2
    echo "Push aborted: binaries / voice codec files in the outgoing commits." >&2
    echo "Fix: git rm --cached <file>, then amend / rebase it out of the commit" >&2
    echo "(.gitignore keeps them out of new commits)." >&2
    [ "$fail" -ne 0 ] || [ "$mapkey_fail" -ne 0 ] || exit 1
fi
if [ "$mapkey_fail" -ne 0 ]; then
    echo >&2
    echo "Push aborted: a map provider API key is in the outgoing commits." >&2
    echo "Keys belong in the web UI's ⚙ Settings (kept in the browser), never in a file." >&2
    echo "Fix: remove it, then amend / rebase the commit that added it - and revoke the" >&2
    echo "key at the provider if it was ever pushed anywhere." >&2
    echo "Not a key (a test vector, an example)? Put $MAP_KEY_OK on that same line." >&2
    [ "$fail" -ne 0 ] || exit 1
fi
if [ "$fail" -ne 0 ]; then
    echo >&2
    echo "Push aborted: station secrets / private keys detected in the outgoing commits." >&2
    echo "Fix: run ./install.sh once (registers the auto-sanitize clean filter)," >&2
    echo "then re-commit the offending file - or amend/rebase the commit out." >&2
    echo "Bypass (know what you are doing): git push --no-verify" >&2
    exit 1
fi
exit 0
