#!/bin/bash
#
# pre-push: block pushes whose OUTGOING commits contain station secrets
# (KrakenPro key, real lat/lon) or a settings file that should never be
# tracked. Backstop behind the clean filter (scripts/git-secrets-clean),
# which sanitizes these automatically at commit time - this hook only fires
# if the filter was not configured (fresh clone before install.sh) or a
# secret landed some other way.
#
# Activated per clone by install.sh:  git config core.hooksPath .githooks
# Emergency bypass:                   git push --no-verify
#
set -u

fail=0

# Scan the commits selected by the rev-list arguments ("$@", passed as
# SEPARATE words - e.g. "$sha" --not --remotes) for secrets in changed
# settings/config files. Returns nonzero if the range can't be resolved, so
# the caller can fail closed instead of silently scanning nothing.
scan_range() {
    local commits
    commits=$(git rev-list "$@" 2>/dev/null) || return 1
    local c f blob
    for c in $commits; do
        # Only files that can carry station config are inspected, so ordinary
        # source/doc changes can never false-positive. --root: a root commit
        # (first commit of a new history) has no parent to diff against and
        # listed nothing without it. -m: a merge commit listed nothing either,
        # so a secret added while resolving a merge slipped through; -m diffs
        # it against each parent (sort -u drops the duplicates). NUL-separated
        # so a path with spaces stays one path.
        while IFS= read -r -d '' f; do
            # A path the commit DELETES is listed too: nothing to leak, and
            # blocking it rejected the very commit that untracks a secret file
            git cat-file -e "$c:$f" 2>/dev/null || continue
            case "$f" in
                *doa_settings.json|*api_token)
                    echo "BLOCKED: $f is committed in ${c:0:9} - this file holds" >&2
                    echo "         the KrakenPro key / station location and must stay untracked." >&2
                    fail=1
                    continue
                    ;;
            esac
            blob=$(git show "$c:$f" 2>/dev/null) || continue
            if echo "$blob" | grep -Eq '"(krakenpro_key|web_mapper_key)"[[:space:]]*:[[:space:]]*"[^"]{6,}"'; then
                echo "BLOCKED: KrakenPro API key found in $f at commit ${c:0:9}." >&2
                fail=1
            fi
            if echo "$blob" | grep -Eq '"(latitude|longitude)"[[:space:]]*:[[:space:]]*-?(0*[1-9][0-9]*|0*\.0*[1-9])'; then
                echo "BLOCKED: real latitude/longitude found in $f at commit ${c:0:9}." >&2
                fail=1
            fi
            if echo "$blob" | grep -E '"static_location"[[:space:]]*:' | grep -Evq '"(0, *0, *0|0,0,0)?"'; then
                echo "BLOCKED: real static_location found in $f at commit ${c:0:9}." >&2
                fail=1
            fi
        done < <(git diff-tree --root -m --no-commit-id --name-only -r -z "$c" -- \
                     '*config.json' '*doa_settings.json' '*settings*.json' \
                     '*api_token' | sort -zu)
    done
    return 0
}

# stdin: <local_ref> <local_sha> <remote_ref> <remote_sha> per ref being pushed
zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue      # branch deletion: nothing outgoing
    if [ "$remote_sha" = "$zero" ]; then
        # New remote branch: scan commits not already on any remote.
        scan_range "$local_sha" --not --remotes || scan_failed=1
    else
        # Update: scan what's new since the remote tip. If that tip isn't in
        # this clone (e.g. a force-push over commits never fetched), fall
        # back to everything not already on a remote.
        scan_range "$remote_sha..$local_sha" ||
            scan_range "$local_sha" --not --remotes || scan_failed=1
    fi
    if [ "${scan_failed:-0}" -ne 0 ]; then
        echo "BLOCKED: could not list the outgoing commits for $local_ref - not scanned." >&2
        fail=1
        scan_failed=0
    fi
done

if [ "$fail" -ne 0 ]; then
    echo >&2
    echo "Push aborted: station secrets detected in the outgoing commits." >&2
    echo "Fix: run ./install.sh once (registers the auto-sanitize clean filter)," >&2
    echo "then re-commit the offending file - or amend/rebase the commit out." >&2
    echo "Bypass (know what you are doing): git push --no-verify" >&2
    exit 1
fi
exit 0
