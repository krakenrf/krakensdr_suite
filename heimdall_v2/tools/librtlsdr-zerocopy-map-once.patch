+	for (i = 0; i < n; i++) {
+		rtlsdr_dev_t *dev = devs[i];
+		if (done_us)
+			done_us[i] = dev && dev->fifo_release_done == 1 ? (int)(dev->fifo_release_us - t0) : -1;
